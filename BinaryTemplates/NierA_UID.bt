/*
NieR:Automata .uid (UI layout) template.
All offsets in the header and entries are relative to file start.
*/

LittleEndian();

const int color1 = 0xEBA434;
const int color2 = 0xEBA454;
const int color3 = 0xEB6434;
const int color4 = 0x64EB34;
const int color5 = 0x64EB54;
const int color6 = 0x64AB14;

struct Vector;
string vectorToStr(const Vector& v) {
	string s = "";
	SPrintf(s, "(%.02f, %.02f, %.02f)", v.x, v.y, v.z);
	return s;
}

struct Vector
{
	float x;
	float y;
	float z;
};

enum <uint32> LayerType {
	LOC = 0,	// locator/container; data names a nested .uid or is absent
	IMG = 1,	// sprite / color fill / fullscreen quad
	_9GD = 2,	// nine-grid
	MSG = 3,	// localized text via .mcd event hash
	STR = 4,	// runtime string (numbers, CORE_MESSAGES_CTRL font)
	TXT = 5,	// free text via FTB font guid
	MSK = 6		// rectangular clip mask for following siblings
};

struct Header
{
	uint32 layerCount;
	uint32 entry2Count;
	uint32 animationCount;
	uint32 layerArrayOffset;
	uint32 entry2Offset;
	uint32 animationOffset;			// 0 when animationCount == 0
	float frameDuration;			// 1/60
	uint32 alignmentFlags<comment="bits[7:4] anchorX, bits[3:0] anchorY (0 start, 1 center, 2 end); 0x11 = centered">;
	uint32 flag0x20<comment="unknown; only set in hud0001/0004/000a/0025/0028/003f/0056; no consumer found in the parse chain">;
	uint32 null0;
	uint32 null1;
	uint32 null2;
};

Header header;

// Procedural random jitter on one property channel (channel = array index,
// same layout as animation property indices). Active when duration, cycles
// and amplitude are all > 0 AND the channel group's randomEnable flag is set.
// A new random target is rolled every duration/cycles seconds; applied
// additively on translation/scale, angle-normalized on rotation, clamped 0..1
// on color/alpha/color2. Runtime supports at most 8 active units per layer.
struct RandomUnit
{
	float duration;
	int32 cycles;
	float amplitude;
	int32 interpMode<comment="0 linear, 1 catmull-rom, 2 step; channels 8-15 always linear">;
};

struct DataLOC
{
	char subUidName[16];	// empty = plain container
	ubyte partIndex;
	ubyte flag2;
	uint16 pad;
	int32 defaultAnimIndex;
};

struct DataIMG
{
	float width;
	float height;
	int32 anchorX;			// 0 start, 1 center, 2 end
	int32 anchorY;
	int32 pivotX<comment="forwarded to the prim's blendStateIndex (GPU blend select)">;
	int32 pivotY;
	int32 renderMode;		// 0 sprite, 1 fullscreen SCREEN_W x SCREEN_H, 2 flipbook
	uint32 textureHash;		// 0 = no texture (color fill / runtime assigned)
	uint32 spriteId;
	ubyte useCrop;
	ubyte textureFlags;
	uint16 pad0;
	ubyte flipX;
	ubyte flipY;
	uint16 pad1;
	float cropLeft;
	float cropTop;
	float cropRight;
	float cropBottom;
	float animSpeed;
	float frameCount;
};

struct Data9GD
{
	float centerW;
	float centerH;
	float borderX;
	float borderY;
	int32 anchorX;
	int32 anchorY;
	int32 pivotX;
	int32 pivotY;
	uint32 textureHash;
	uint32 spriteId;
	ubyte useSpriteSize;
	ubyte textureFlags;
	ubyte flipX;
	ubyte flipY;
	ubyte alphaFlag;
	ubyte scaleMode;
};

struct DataMSG
{
	uint32 flags;
	char mcdName[16];
	uint32 msgIds[8];		// crc32_ci event hashes; [0] is the default
	int32 paragraphIndex;
	ubyte pad0[0x20];
	ubyte anchorPacked;
	ubyte pad1;
	byte shadowOffsetX;
	byte shadowOffsetY;
	float letterSpacing;	// animatable via property 16
	float lineSpacing;		// animatable via property 17
	ubyte pad2[0xc];
	uint16 renderAlign0;
	uint16 renderAlign1;
	float shadowColor[4];
	float mainColor[4];
};

struct DataSTR
{
	uint32 pad0[2];
	uint32 anchorH;
	uint32 anchorV;
	float letterSpacing;
	uint32 pad1[2];
	uint32 kerning;
	uint32 pad2;
	uint32 shadowMode;
	uint32 mainMode;
	uint32 pad3[2];
	float shadowColor[4];
	float mainColor[4];
	int16 shadowField2;
	int16 mainField2;
	uint32 offsetX;
	uint32 offsetY;
};

struct DataTXT
{
	char fontGuid[36];
	uint32 pad0[3];
	int16 posX0;
	int16 posY0;
	int16 posX1;
	int16 posY1;
	float scaleX;
	float scaleY;
	ubyte alignH;
	ubyte alignV;
	ubyte offsetAlignX;
	ubyte offsetAlignY;
	ubyte isEnabled;
	ubyte pad1;
	ubyte centerLines;
	ubyte pad2;
	uint32 renderFlagsPass1;
	ubyte wrapMode;
	ubyte pad3[3];
	uint32 renderFlagsPass0;
	ubyte wrapMode2;
	ubyte pad4[2];
	ubyte justify;
	ubyte autoShrink;
};

struct DataMSK
{
	ubyte mode0;			// 1 = rect mask
	ubyte mode1;
	ubyte mode2;
	ubyte pad;
	ubyte anchorX[4];
	ubyte anchorY[4];
	float width;
	float height;
};

// One keyframed property curve. Values are quantized: value = raw * scale + min.
// Every keyframed property of a layer is sampled EVERY frame against the
// layer's shared timeline (no per-animation filter); outside the key range it
// clamps to the first/last key.
struct PropHeader
{
	uint32 keyframeOffset;
	uint32 keyCount;
	uint32 propertyIndex<comment="0-2 translation, 3-5 rotation, 6-7 scale, 8-10 color, 11 alpha, 12-15 color2, 16 letterSpacing (MSG/STR), 17 lineSpacing, 18 third text slot">;
	float minValue;
	float scale;			// maxValue = minValue + scale * 65535
	float startTime;
	float endTime;
	uint32 wrapFlag;		// non-zero: wrap the sampled time into [start, end]
};

struct Keyframe
{
	float time;
	uint16 raw;				// value = raw * scale + minValue
	uint16 pad;				// always 0
};

// Step-sampled [time, textureHash] keys; the layer's texture is swapped to the
// hash of the last key <= current frame. Present in the engine but unused by
// every shipped .uid (dataOffsetTextureSwap is always 0).
struct TextureSwapHeader
{
	uint32 keysOffset;
	uint32 keyCount;
	float startTime;
	float endTime;
	uint32 wrapFlag;
};

struct PropBlock(int count)
{
	PropHeader headers[count];
	local int i;
	for (i = 0; i < count; i++) {
		struct {
			FSeek(headers[i].keyframeOffset);
			Keyframe keys[headers[i].keyCount];
		} curve;
	}
};

struct Entry1
{
	Vector translation<read=vectorToStr>;
	Vector rotation<read=vectorToStr>;
	Vector scale<read=vectorToStr>;
	Vector RGB<read=vectorToStr>;
	float alpha;
	float color2[4]<comment="secondary color, always opaque white in shipped files; gradient target and capture-extension parameter (RetroGrid mode 1/2), animatable via properties 12-15">;
	int32 parentIndex;		// entry index, -1 = root
	uint32 layerId;			// 1-based id referenced by animations / entry2
	uint32 visibleFlag;
	uint32 treeDepth<comment="depth of this layer in the parent chain (root 0); redundant, parser rejects > 9">;
	uint32 null2;
	uint16 gradientMode<comment="0 off, 1 horizontal, 2 vertical: blends RGB -> color2 across the quad">;
	uint16 gradientOffsetPx;
	uint16 gradientLengthPx;
	uint16 pad0;
	uint32 layoutType<comment="bits[7:6] anchorH, bits[5:4] anchorV, bits[3:2] pivotMode">;
	float zOrder;
	uint32 ignoreParentTranslation;
	uint32 animEnableTranslation;
	uint32 randomEnableTranslation;
	uint32 ignoreParentRotation;
	uint32 animEnableRotation;
	uint32 randomEnableRotation;
	uint32 ignoreParentScale;
	uint32 animEnableScale;
	uint32 randomEnableScale;
	uint32 ignoreParentColor;
	uint32 animEnableColor;
	uint32 randomEnableColor;
	RandomUnit randomUnits[16];
	LayerType layerType;
	uint32 extTypeId;		// cUIEx* type id, 0 = none
	uint32 propCount;		// keyframed property curves at dataOffset3
	uint32 dataOffset1;		// layer type payload (Data*)
	uint32 dataOffset2;		// extension slots (u32 each; size = ext data struct)
	uint32 dataOffset3;		// PropHeader[propCount] + keyframes
	uint32 dataOffsetTextureSwap;

	local int pos = FTell();
	if (dataOffset1 != 0) {
		FSeek(dataOffset1);
		switch (layerType) {
			case LOC:  DataLOC data<bgcolor=color4>; break;
			case IMG:  DataIMG data<bgcolor=color4>; break;
			case _9GD: Data9GD data<bgcolor=color4>; break;
			case MSG:  DataMSG data<bgcolor=color4>; break;
			case STR:  DataSTR data<bgcolor=color4>; break;
			case TXT:  DataTXT data<bgcolor=color4>; break;
			case MSK:  DataMSK data<bgcolor=color4>; break;
		}
	}
	if (dataOffset3 != 0 && propCount > 0) {
		FSeek(dataOffset3);
		PropBlock props(propCount)<bgcolor=color6>;
	}
	if (dataOffsetTextureSwap != 0) {
		FSeek(dataOffsetTextureSwap);
		TextureSwapHeader textureSwap<bgcolor=color5>;
	}
	FSeek(pos);
};

struct Entry2
{
	uint32 layerId;
	uint32 entry1Index;
};

// Animations are frame windows on the shared per-layer timeline. Playing one
// retargets the window of every referenced layer (layerRefs, 1-based layer
// ids, 0xFF = empty) and unpauses them; the property curves themselves live
// per layer (dataOffset3).
struct Animation
{
	uint32 index;			// id used by play_animation
	float startFrame;		// seconds
	float endFrame;
	uint32 reverse;			// 1 = ping-pong/loop
	ubyte layerRefs[48];
};

FSeek(header.layerArrayOffset);
struct {
	Entry1 entries[header.layerCount]<bgcolor=color1, optimize=false>;
} entries1;

FSeek(header.entry2Offset);
Entry2 entries2[header.entry2Count]<bgcolor=color2>;

if (header.animationOffset != 0) {
	FSeek(header.animationOffset);
	Animation animations[header.animationCount]<bgcolor=color3>;
}
