/*
UiData
*/

LittleEndian();

const int color1 = 0xEBA434;
const int color2 = 0xEBA454;
const int color3 = 0xEB6434;
const int color4 = 0x64EB34;
const int color5 = 0x64EB54;
const int color6 = 0x64AB14;

string inverseToStr(float f) {
	if (f == 0)
		return "0.0";
	string s = "";
	float inv = 1.f / f;
	SPrintf(s, "%f", inv);
	return s;
}

struct Vector;
string vectorToStr(const Vector& v) {
	string s = "";
	SPrintf(s, "(%.02f, %.02f, %.02f)", v.x, v.y, v.z);
	return s;
}

struct Vector
{
	float x;
	float y;
	float z;
};

enum <uint32> LayerType {
	LOC = 0,
	IMG = 1,
	_9GD = 2,
	MSG = 3,
	STR = 4,
	TXT = 5,
	MSK = 6
};

struct Header
{
	uint32 layerCount;
	uint32 layerIdMapCount;
	uint32 animationCount;
	uint32 layerArrayOffset;
	uint32 layerIdMapOffset;
	uint32 animationOffset;
	float frameDuration<comment="1 / 60 FPS">;
	uint32 alignmentFlags<comment="bits[7:4] anchorX, bits[3:0] anchorY (0 start, 1 center, 2 end)">;
	uint32 flag0x20;	// unknown; only set in hud0001/0004/000a/0025/0028/003f/0056
	uint32 null0;
	uint32 null1;
	uint32 null2;
};

Header header;

// rolled every duration/cycles seconds, scaled by amplitude; active when
// duration, cycles and amplitude > 0 and the group's randomEnable flag is set
struct RandomUnit
{
	float duration;
	int32 cycles;
	float amplitude;
	int32 interpMode;	// 0 linear, 1 catmull-rom, 2 step; channels 8-15 always linear
};

struct LayerPayload;
struct ExtensionSlots;
struct PropertyCurves;
struct PropertyCurveHeader;
struct Keyframe;
struct TextureSwapKeys;
struct LayerEntry
{
	Vector translation<read=vectorToStr>;
	Vector rotation<read=vectorToStr>;
	Vector scale<read=vectorToStr>;
	Vector RGB<read=vectorToStr>;
	float alpha;
	float color2[4]<comment="always opaque white; gradient target color, capture-ext params, anim properties 12-15">;
	int32 parentIndex;		// layer index, -1 = root
	uint32 layerId;
	uint32 visibleFlag;
	uint32 treeDepth;		// depth in the parent chain (root 0); parser rejects > 9
	uint32 null2;
	uint16 gradientMode;	// 0 off, 1 horizontal, 2 vertical: RGB -> color2 across the quad
	uint16 gradientOffsetPx;
	uint16 gradientLengthPx;
	uint16 pad0;
	/*
	_____0__	top edge centered
	_____1__	Y centered
	____1___	bottom edge centered
	___0____	left edge centered
	___1____	X centered
	__1_____	right edge centered
	_1______	Row
	1_______	Column
	*/
	uint32 layoutType<comment="bits[7:6] anchorH, bits[5:4] anchorV, bits[3:2] pivotMode">;
	float zOrder;
	uint32 ignoreParentTranslation;
	uint32 animEnableTranslation;
	uint32 randomEnableTranslation;
	uint32 ignoreParentRotation;
	uint32 animEnableRotation;
	uint32 randomEnableRotation;
	uint32 ignoreParentScale;
	uint32 animEnableScale;
	uint32 randomEnableScale;
	uint32 ignoreParentColor;
	uint32 animEnableColor;
	uint32 randomEnableColor;
	RandomUnit randomUnits[16];	// index = property channel
	LayerType layerType;
	uint32 extTypeId;		// cUIEx* type id, 0 = none
	uint32 propertyCount;
	uint32 payloadOffset;
	uint32 extensionOffset;
	uint32 curvesOffset;
	uint32 textureSwapOffset;	// unused in shipped files

	local int pos = FTell();
	if (payloadOffset != 0) {
		FSeek(payloadOffset);
		LayerPayload payload(layerType)<bgcolor=color4>;
	}
	if (curvesOffset != 0 && propertyCount > 0) {
		FSeek(curvesOffset);
		PropertyCurves curves(propertyCount)<bgcolor=color6>;
	}
	if (textureSwapOffset != 0) {
		FSeek(textureSwapOffset);
		TextureSwapKeys textureSwap<bgcolor=color5>;
	}
	FSeek(pos);
};

struct LayerPayload(LayerType type)
{
	switch (type) {
	case LOC:
		char subUidName[16];	// empty = plain container
		uint16 partIndex;
		uint16 pad;
		int32 defaultAnimIndex;
		break;
	case IMG:
		float width;
		float height;
		int32 anchorX;			// 0 start, 1 center, 2 end
		int32 anchorY;
		int32 pivotX<comment="forwarded to the prim's GPU blend state select">;
		int32 pivotY;
		int32 renderMode;		// 0 sprite, 1 fullscreen, 2 flipbook
		uint32 textureHash;		// 0 = color fill / runtime assigned
		uint32 spriteId;
		ubyte useCrop;
		ubyte textureFlags;
		uint16 pad0;
		ubyte flipX;
		ubyte flipY;
		uint16 pad1;
		float cropLeft;
		float cropTop;
		float cropRight;
		float cropBottom;
		float animSpeed;
		float frameCount;
		break;
	case _9GD:
		float centerW;
		float centerH;
		float borderX;
		float borderY;
		int32 anchorX;
		int32 anchorY;
		int32 pivotX;
		int32 pivotY;
		uint32 textureHash;
		uint32 spriteId;
		ubyte useSpriteSize;
		ubyte textureFlags;
		ubyte flipX;
		ubyte flipY;
		ubyte alphaFlag;
		ubyte scaleMode;
		break;
	case MSG:
		uint32 flags;
		char mcdName[16];
		uint32 msgIds[8];		// crc32_ci event hashes, [0] default
		int32 paragraphIndex;
		ubyte pad0[0x20];
		ubyte anchorPacked;
		ubyte pad1;
		byte shadowOffsetX;
		byte shadowOffsetY;
		float letterSpacing;	// anim property 16
		float lineSpacing;		// anim property 17
		ubyte pad2[0xc];
		uint16 renderAlign0;
		uint16 renderAlign1;
		float shadowColor[4];
		float mainColor[4];
		break;
	case STR:
		uint32 pad0[2];
		uint32 anchorH;
		uint32 anchorV;
		float letterSpacing;
		uint32 pad1[2];
		uint32 kerning;
		uint32 pad2;
		uint32 shadowMode;
		uint32 mainMode;
		uint32 pad3[2];
		float shadowColor[4];
		float mainColor[4];
		int16 shadowField2;
		int16 mainField2;
		uint32 offsetX;
		uint32 offsetY;
		break;
	case TXT:
		char fontGuid[36];
		uint32 pad0[3];
		int16 posX0;
		int16 posY0;
		int16 posX1;
		int16 posY1;
		float scaleX;
		float scaleY;
		ubyte alignH;
		ubyte alignV;
		ubyte offsetAlignX;
		ubyte offsetAlignY;
		ubyte isEnabled;
		ubyte pad1;
		ubyte centerLines;
		ubyte pad2;
		uint32 renderFlagsPass1;
		ubyte wrapMode;
		ubyte pad3[3];
		uint32 renderFlagsPass0;
		ubyte wrapMode2;
		ubyte pad4[2];
		ubyte justify;
		ubyte autoShrink;
		break;
	case MSK:
		ubyte mode0;			// 1 = rect mask
		ubyte mode1;
		ubyte mode2;
		ubyte pad;
		ubyte anchorX[4];
		ubyte anchorY[4];
		float width;
		float height;
		break;
	}
};

// extension parameter slots; count = size of the cUIEx* data struct
struct ExtensionSlots
{
	uint32 slots[1];
};

struct PropertyCurves(int count)
{
	PropertyCurveHeader headers[count];
	local int i = 0;
	for (i = 0; i < count; i++) {
		struct {
			FSeek(headers[i].keyframeOffset);
			Keyframe keys[headers[i].keyCount];
		} curves;
	}
};

enum PropertyIndex {
	Translation_X = 0,
	Translation_Y = 1,
	Translation_Z = 2,
	Rotation_X = 3,
	Rotation_Y = 4,
	Rotation_Z = 5,
	Scale_X = 6,
	Scale_Y = 7,
	Color_R = 8,
	Color_G = 9,
	Color_B = 10,
	Alpha = 11,
	Color2_R = 12,
	Color2_G = 13,
	Color2_B = 14,
	Color2_A = 15,
	LetterSpacing = 16,		// MSG/STR only
	LineSpacing = 17,		// MSG/STR only
	TextSlot3 = 18			// MSG/STR only
};
// every property is sampled every frame against the layer's shared timeline;
// outside the key range it clamps to the first/last key
struct PropertyCurveHeader
{
	uint32 keyframeOffset;
	uint32 keyCount;
	PropertyIndex propertyIndex;
	float minValue;
	float scale;			// maxValue = minValue + scale * 65535
	float startTime;
	float endTime;
	uint32 wrapFlag;		// non-zero: wrap sampled time into [start, end]
};
struct Keyframe
{
	float time;
	uint16 val;				// value = val * scale + minValue
	uint16 null0;
};

// step-sampled texture swap keys (engine feature, unused in shipped files)
struct TextureSwapKeys
{
	uint32 keysOffset;
	uint32 keyCount;
	float startTime;
	float endTime;
	uint32 wrapFlag;
};

struct LayerIdMapping
{
	uint32 layerId;
	uint32 layerIndex;
};

// animations: frame windows on the shared per-layer timeline; playing one
// retargets the window of every referenced layer and unpauses it
struct Animation
{
	uint32 animIndex;
	float startFrame;
	float endFrame;
	uint32 reverse;			// 1 = ping-pong/loop
	ubyte layerRefs[48];	// 1-based layer ids, 0xFF = empty
};


FSeek(header.layerArrayOffset);
struct {
	LayerEntry layers[header.layerCount]<bgcolor=color1, optimize=false>;
} layerEntries;

FSeek(header.layerIdMapOffset);
LayerIdMapping layerIdMap[header.layerIdMapCount]<bgcolor=color2>;

if (header.animationOffset != 0) {
	FSeek(header.animationOffset);
	Animation animations[header.animationCount]<bgcolor=color3>;
}
